# ============================================================================
# CONFIGURAÇÃO DE AMBIENTE — META MÁXIMA DIGITAL
# ============================================================================
# Copie este arquivo para .env.local e configure os identificadores reais.
# Os valores com prefixo NEXT_PUBLIC_* são expostos no bundle do cliente.
# ============================================================================

# 1. URL pública definitiva de produção (usada para canonical, Open Graph e sitemap)
# Padrão oficial: https://agenciametamaximadigital.vercel.app
NEXT_PUBLIC_SITE_URL=https://agenciametamaximadigital.vercel.app

# 2. Meta Pixel ID (Obtido em Meta Business Suite > Gerenciador de Eventos > Fontes de Dados)
# Formato numérico, ex: 123456789012345
# Eventos integrados: PageView (visita), Contact (botão WhatsApp direto), Lead (envio válido do formulário)
NEXT_PUBLIC_META_PIXEL_ID=

# 3. WhatsApp comercial oficial (formato E.164 sem o '+', ex: DDI 55 + DDD 21 + número)
# Padrão definido no código: 5521984393482
NEXT_PUBLIC_WHATSAPP_NUMBER=5521984393482

# (Opcional) Google Analytics 4 (Formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# (Opcional) Google Tag Manager (Formato GTM-XXXXXXX)
# Se gerenciar o Pixel e o GA4 pelo GTM, deixe NEXT_PUBLIC_META_PIXEL_ID e NEXT_PUBLIC_GA4_ID vazios
NEXT_PUBLIC_GTM_ID=

