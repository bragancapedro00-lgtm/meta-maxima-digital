# Copie este arquivo para .env.local e preencha apenas os IDs reais.
# Todos são opcionais: se ficarem vazios, nenhum script de rastreamento é carregado.
# Os valores NEXT_PUBLIC_* são públicos por natureza (vão para o navegador) — não coloque segredos aqui.

# URL pública final do site (usada no Open Graph e na URL canônica). Ex.: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# Meta Pixel (Gerenciador de Eventos > Fontes de dados). Somente números.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 (Administrador > Fluxos de dados). Formato G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager. Formato GTM-XXXXXXX
# Se usar o GTM para disparar Pixel/GA4, deixe os dois campos acima vazios para não duplicar eventos.
NEXT_PUBLIC_GTM_ID=

# (Opcional) Sobrescreve o WhatsApp comercial definido em src/config/site.ts.
# Formato internacional, apenas números: DDI + DDD + número. Ex.: 5521900000000
# NEXT_PUBLIC_WHATSAPP_NUMBER=
